{
  "package": "quickbooks",
  "notes": "Modelled on the QuickBooks Online UK 'Transaction Detail by Account' export (account names, signed Amount). Map by full account name; edit to match each client's chart.",
  "date_formats": [
    "%d/%m/%Y"
  ],
  "amount_mode": "signed",
  "columns": {
    "date": "Date",
    "code": "Account",
    "account": "Account",
    "description": "Memo/Description",
    "contact": "Name",
    "reference": "No.",
    "amount": "Amount",
    "vat": "Tax Amount",
    "facts": "BRG Facts"
  },
  "codes": {
    "Sales": {
      "category": "sales"
    },
    "Other Income": {
      "category": "other_income"
    },
    "Interest Earned": {
